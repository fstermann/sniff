#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

if [ -x "$ROOT/target/release/sniff" ]; then
  exec "$ROOT/target/release/sniff" "$@"
fi

if [ -x "$ROOT/target/debug/sniff" ]; then
  exec "$ROOT/target/debug/sniff" "$@"
fi

if command -v cargo >/dev/null 2>&1; then
  exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- "$@"
fi

echo "sniff: error: install a sniff release binary or install Rust to build from source" >&2
exit 2
